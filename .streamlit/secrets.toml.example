# Copy this into Streamlit Cloud → your app → Settings → Secrets (never commit real secrets to GitHub).

# Supabase → Project → Connect → "Session pooler" connection string (works on Streamlit Cloud, IPv4).
DATABASE_URL = "postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Staff logins: each person signs in with their own name + password, and that name is
# stamped on every receipt, transfer and adjustment they post.
[users]
Nii = "change-me"
Warehouse1 = "change-me-too"
